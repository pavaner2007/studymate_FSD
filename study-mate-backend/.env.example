# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/studymate

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Groq Cloud AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Client Application URL (CORS origin)
CLIENT_URL=http://localhost:5173

# Optional: Supadata API for YouTube Transcript fetching
SUPADATA_API_KEY=your_supadata_api_key_here
